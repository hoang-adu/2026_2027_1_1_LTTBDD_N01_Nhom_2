@startuml
|Người dùng|
start
:Mở chi tiết bộ từ (DeckDetailScreen);
:Nhấn nút thêm từ mới (Mở _WordFormDialog);
:Nhập term, meaning, phonetic, example;
:Nhấn nút Lưu;

|Hệ thống|
:Validate dữ liệu đầu vào (_save);
if (Term hoặc Meaning bị trống?) then (Đúng)
  :Hiển thị lỗi / Không thực hiện lưu;
  |Người dùng|
  :Nhập lại thông tin hợp lệ;
  detach
else (Hợp lệ)
  :DeckProvider gọi addWord();
  :Cập nhật danh sách từ trong Deck;
  :Lưu dữ liệu qua DeckRepository vào SharedPreferences;
  :notifyListeners() làm mới giao diện;
  
  |Người dùng|
  :Nhìn thấy từ mới xuất hiện trong danh sách từ;
endif
stop
@enduml