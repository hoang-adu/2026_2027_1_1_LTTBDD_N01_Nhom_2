@startuml
|Người dùng|
start
:Mở QuizScreen, chọn "Điền từ";

|Hệ thống|
:QuizScreen kiểm tra số từ của bộ (cần >= 1 từ);
if (Số từ < 1?) then (Đúng)
  :SnackBar quiz_notEnoughWordsTyping\n(vẫn ở QuizScreen);
  stop
else (Có từ)
  :Navigator.push QuizPlayScreen;
  :QuizProvider.generateQuiz(deck, typing)\nxáo từ, tối đa 20 câu;
  if (Sinh câu hỏi thành công?) then (Không)
    :Navigator.pop về QuizScreen;
    stop
  else (Có)
    repeat
      |Người dùng|
      :Đọc nghĩa tiếng Việt (+ phiên âm nếu có);
      if (Thao tác?) then (Bỏ qua)
        |Hệ thống|
        :submitAnswer('') → tính sai;
      else (Gõ từ + Xác nhận / Enter / Câu tiếp theo)
        |Hệ thống|
        :submitAnswer(text)\n(chấm: trim, gộp khoảng trắng, không phân biệt hoa/thường);
      endif
      :nextQuestion();
    repeat while (Còn câu hỏi?) is (Còn)
    ->Hết;
    :calculateResult() → QuizResult;
    :pushReplacement sang QuizResultScreen;

    |Người dùng|
    :Xem điểm %, "Bạn đã gõ" và đáp án đúng của câu sai;
  endif
endif
stop
@enduml
