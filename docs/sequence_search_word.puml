@startuml
autonumber
actor "Người dùng" as User
participant "WordListToolbar\n(SearchBar)" as Toolbar
participant "DeckDetailScreen" as UI
participant "DeckProvider" as Provider

note over UI, Provider
  Tìm kiếm chỉ lọc dữ liệu trong bộ nhớ,
  không gọi DeckRepository / SharedPreferences.
end note

User -> Toolbar: Gõ từ khóa
Toolbar -> UI: onQueryChanged(keyword)
UI -> UI: _onQueryChanged → setState(_query = keyword)
UI -> UI: build() → _visibleWords(provider)
UI -> Provider: searchWords(deckId, _query)
Provider --> UI: List<Word> khớp term HOẶC meaning (không phân biệt hoa/thường)
UI -> Provider: filterWords(words, _filter)
Provider --> UI: List<Word> theo bộ lọc
opt Đã chọn sắp xếp A–Z / Z–A
    UI -> Provider: sortWords(words, ascending: ...)
    Provider --> UI: List<Word> đã sắp xếp
end
alt Danh sách rỗng
    UI --> User: EmptyState deck_noResultsTitle
else Có kết quả
    UI --> User: Hiển thị danh sách WordTile
end
@enduml
