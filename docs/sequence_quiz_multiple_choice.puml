@startuml
autonumber
actor "Người dùng" as User
participant "QuizScreen" as UI1
participant "QuizPlayScreen" as UI2
participant "DeckProvider" as DeckProvider
participant "QuizProvider" as Quiz
participant "QuizResultScreen" as UIResult

User -> UI1: Chọn "Trắc nghiệm"
UI1 -> DeckProvider: getDeckById(deckId) (trong build)
DeckProvider --> UI1: Deck → wordCount
alt wordCount < 4
    UI1 --> User: SnackBar quiz_notEnoughWordsMc
else Đủ 4 từ
    UI1 -> UI2: Navigator.push(QuizPlayScreen(deckId, multipleChoice))
    UI2 -> DeckProvider: getDeckById(deckId)
    DeckProvider --> UI2: Deck
    UI2 -> Quiz: generateQuiz(deck, QuizType.multipleChoice)
    alt false (không đủ 3 nghĩa nhiễu khác nhau)
        Quiz --> UI2: false
        UI2 --> User: SnackBar quiz_notEnoughDistinctMeanings (hoặc deck_notFound)
        UI2 -> UI1: Navigator.pop
    else true
        Quiz --> UI2: true (tối đa 20 câu, mỗi câu 1 đúng + 3 nhiễu)
        loop Mỗi câu hỏi
            alt Chọn đáp án
                User -> UI2: Chọn RadioListTile + bấm Câu tiếp theo / Nộp bài
                UI2 -> Quiz: submitAnswer(option)
            else Bỏ qua
                User -> UI2: Bấm Bỏ qua
                UI2 -> Quiz: submitAnswer('')
            end
            UI2 -> Quiz: nextQuestion()
        end
        UI2 -> Quiz: calculateResult()
        Quiz --> UI2: QuizResult
        UI2 -> UIResult: Navigator.pushReplacement(QuizResultScreen(result, deckId))
        UIResult --> User: Điểm % (AnimatedCount) + chi tiết đúng/sai
    end
end
@enduml
