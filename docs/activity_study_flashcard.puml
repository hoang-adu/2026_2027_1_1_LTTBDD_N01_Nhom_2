@startuml
|Người dùng|
start
:Mở chi tiết bộ từ (DeckDetailScreen);
:Bấm nút Học;

|Hệ thống|
:DeckDetailScreen._study() kiểm tra deck.wordCount;
if (Bộ rỗng (0 từ)?) then (Đúng)
  :SnackBar "Bộ từ chưa có từ vựng,\nvui lòng thêm từ trước khi học";
  :Mở form thêm từ (showWordFormDialog);
  |Người dùng|
  :Thêm từ hoặc hủy form;
  stop
else (Có từ)
  |Hệ thống|
  :Mở StudyScreen;
  :StudyProvider.startStudy(deckId)\n(lấy Deck qua DeckProvider.getDeckById);
  :Hiển thị thẻ đầu tiên + thanh tiến độ;

  repeat
    |Người dùng|
    :Chọn thao tác trên thẻ;
    split
      :Chạm thẻ để lật;
      |Hệ thống|
      :FlashcardWidget lật mặt (AnimatedSwitcher);
    split again
      |Người dùng|
      :Bấm loa;
      |Hệ thống|
      :TtsService.speak(term);
    split again
      |Người dùng|
      :Bấm đánh dấu đã thuộc;
      |Hệ thống|
      :StudyProvider.toggleLearned()\n→ DeckProvider.toggleLearned()\n→ lưu SharedPreferences;
    split again
      |Người dùng|
      :Vuốt thẻ hoặc bấm nút Tiếp;
      |Hệ thống|
      :StudyProvider.goTo(index), cập nhật tiến độ;
    end split
    |Người dùng|
  repeat while (Chưa tới thẻ cuối hoặc muốn học tiếp?) is (Tiếp tục)
  ->Bấm Hoàn thành ở thẻ cuối;
  |Hệ thống|
  :StudyProvider.nextCard() → isFinished = true;
  :Hiện màn "Bạn đã hoàn thành bộ thẻ!";
  |Người dùng|
  :Bấm Quay lại (hoặc nút X bất cứ lúc nào);
  |Hệ thống|
  :Quay lại DeckDetailScreen;
endif
stop
@enduml
