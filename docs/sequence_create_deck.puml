@startuml
autonumber
actor "Người dùng" as User
participant "DeckListScreen" as UI
participant "_DeckNameDialog" as Dialog
participant "DeckProvider" as Provider
participant "DeckRepository" as Repo
participant "SharedPreferences" as Prefs

User -> UI: Bấm FAB "Tạo bộ mới"
UI -> UI: _createDeck()
UI -> Dialog: showDeckNameDialog(onSubmit: addDeck)
User -> Dialog: Nhập tên + bấm Tạo
Dialog -> Dialog: _submit()
Dialog -> Provider: addDeck(name)
alt Tên trống sau trim
    Provider --> Dialog: false
    Dialog --> User: errorText deck_nameEmpty, giữ dialog
else Tên hợp lệ
    Provider -> Provider: _decks.add(Deck(id, name))
    Provider -> Repo: saveDecks(decks)
    Repo -> Prefs: setString('decks_v1', jsonEncode)
    Prefs --> Repo: true
    Repo --> Provider: Hoàn tất
    Provider -> Provider: notifyListeners()
    Provider --> Dialog: true
    Dialog -> UI: Navigator.pop
    UI --> User: DeckCard mới xuất hiện trong danh sách
end
@enduml
