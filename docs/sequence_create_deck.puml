@startuml
autonumber
actor "Người dùng" as User
participant "DeckListScreen" as UI
participant "_DeckNameDialog" as Dialog
participant "DeckProvider" as Provider
participant "DeckRepository" as Repo
participant "SharedPreferences" as Prefs

User -> UI: Nhấn nút FAB (_createDeck)
UI -> Dialog: Hiển thị showDeckNameDialog
User -> Dialog: Nhập tên bộ từ & Bấm Xác nhận (_submit)
alt Tên bộ từ trống
    Dialog --> User: Báo lỗi / Trả về false (Không tạo)
else Tên hợp lệ
    Dialog -> Provider: addDeck(String name)
    Provider -> Repo: saveDecks(decks)
    Repo -> Prefs: setString('decks_v1', jsonEncode)
    Prefs --> Repo: Lưu thành công
    Repo --> Provider: Hoàn tất
    Provider --> Provider: notifyListeners()
    Provider --> UI: Hiển thị bộ từ mới trên danh sách
end
@enduml