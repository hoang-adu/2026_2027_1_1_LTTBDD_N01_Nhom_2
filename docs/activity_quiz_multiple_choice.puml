@startuml
|Người dùng|
start
:Chọn chế độ Trắc nghiệm (Multiple Choice);

|Hệ thống|
:Kiểm tra số lượng từ (Cần >= 4 từ);
if (Đủ điều kiện?) then (Không)
  :Hiển thị SnackBar báo lỗi thiếu từ;
  stop
else (Đủ)
  :QuizProvider sinh ngẫu nhiên câu hỏi & 4 đáp án;
  :Mở màn hình QuizPlayScreen;
  
  repeat
    |Người dùng|
    :Đọc câu hỏi và chọn 1 đáp án;
    :Bấm nút "Câu tiếp theo" hoặc "Nộp bài";
    
    |Hệ thống|
    :Lưu câu trả lời vào QuizProvider;
    :Kiểm tra còn câu hỏi tiếp theo không?;
  repeat while (Còn câu hỏi?) is (Có)
  
  |Hệ thống|
  :Tính toán kết quả (QuizResult);
  :Chuyển sang màn hình QuizResultScreen;
  |Người dùng|
  :Xem điểm số và chi tiết đúng/sai;
endif
stop
@enduml