@startuml
|Người dùng|
start
:Mở QuizScreen, chọn "Trắc nghiệm";

|Hệ thống|
:QuizScreen kiểm tra số từ của bộ (cần >= 4 từ);
if (Số từ < 4?) then (Đúng)
  :SnackBar quiz_notEnoughWordsMc\n(vẫn ở QuizScreen);
  stop
else (Đủ 4 từ)
  :Navigator.push QuizPlayScreen;
  :QuizProvider.generateQuiz(deck, multipleChoice)\nxáo từ, tối đa 20 câu, 1 đúng + 3 nghĩa nhiễu;
  if (Sinh câu hỏi thành công?) then (Không - bộ thiếu 3 nghĩa khác nhau)
    :Navigator.pop về QuizScreen;
    stop
  else (Có)
    repeat
      |Người dùng|
      :Đọc từ tiếng Anh, chọn 1 nghĩa tiếng Việt;
      if (Thao tác?) then (Bỏ qua)
        |Hệ thống|
        :submitAnswer('') → tính sai, reset combo;
      else (Câu tiếp theo / Nộp bài)
        |Hệ thống|
        :submitAnswer(đáp án đã chọn);
        :Đúng liên tiếp >= 2 → hiện combo x2 / x3;
      endif
      :nextQuestion();
    repeat while (Còn câu hỏi?) is (Còn)
    ->Hết;
    :calculateResult() → QuizResult;
    :pushReplacement sang QuizResultScreen;

    |Người dùng|
    :Xem điểm % và chi tiết đúng/sai từng câu;
  endif
endif
stop
@enduml
